{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_SITE_URL": "https://app.marginal-econ.workers.dev"
  },
  "observability": {
    "enabled": true,
  },
}
